# Copy to .env. Sample mode stays on localhost and uses fictional data.
# Every mode requires a server-only CopilotKit Intelligence project key.
WORKSPACE_MODE=sample
AGENT_BACKEND=sample
PORT=8787
HOST=127.0.0.1
PUBLIC_API_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
DATA_DIR=.o1
TASK_WORKER_ENABLED=true

# General delegated work: select AGENT_BACKEND=model and a provider/model.
# MODEL=openai/your-model-id
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# Optional OpenAI-compatible Responses API endpoint:
# OPENAI_BASE_URL=
# For a gateway model ID such as vendor/model, set MODEL=openai/vendor/model.

# Live Google workspace: WORKSPACE_MODE=live, AGENT_BACKEND=model.
# O1_ACCESS_KEY=  # random secret, at least 24 characters
# TOKEN_ENCRYPTION_KEY=  # 32 random bytes encoded as base64
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OAuth callback is PUBLIC_API_URL + /api/google/callback

# Optional separate task worker; all processes share DATA_DIR for PDF files.
# DATABASE_URL=postgresql://...
# Set TASK_WORKER_ENABLED=false on the API when using pnpm dev:worker.

# Browser worker (separate from the task worker):
# BROWSER_WORKER_URL=http://127.0.0.1:8790
# WORKER_TOKEN=  # same random 32+ character secret in API and browser worker
WORKER_DATA_DIR=.o1/browser-profiles
WORKER_HOST=127.0.0.1

# An optional external raw AG-UI agent replaces conversational routing only.
# AGENT_BACKEND=agui
# AGENT_URL=https://your-agent.example/run
# AGENT_TOKEN=
# OpenBot's Intelligence runtime is not this raw AG-UI URL. See its adapter docs.

# CopilotKit Intelligence is required in every mode. Create or select a project
# with the commands below, then keep the generated key server-only.
# npx copilotkit@latest login
# npx copilotkit@latest project select
CPK_INTELLIGENCE_API_KEY=

# Persistent computer provider (production target).
# Remote O1 computer gateway (server-only):
# O1_COMPUTER_GATEWAY_URL=https://computer-gateway.internal
# O1_COMPUTER_PROVISIONING_ENABLED=false
# O1_COMPUTER_GATEWAY_TOKEN=
# HETZNER_API_TOKEN=  # server-only token for the O1 Hetzner adapter
# HETZNER_LOCATION=fsn1
# HETZNER_SERVER_TYPE=cpx22
# HETZNER_IMAGE=ubuntu-24.04
# Optional private Docker Linux computer (separate from the browser).
# Build first: docker build -t o1-computer:local apps/computer
# Docker must be reachable from the API and any separate task worker.
COMPUTER_ENABLED=false
COMPUTER_IMAGE=o1-computer:local
# Stable deployment name shared by API and worker; defaults to a hash of PUBLIC_API_URL.
# COMPUTER_DEPLOYMENT_ID=my-o1
# Optional scoped Docker engine, e.g. DOCKER_CONTEXT=colima-o1

# O1 connector bus. Add only credentials you actually intend to expose to agents.
# iMessage bridge runs on a Mac signed into the Messages account; keep its token server-side.
# IMESSAGE_BRIDGE_URL=http://127.0.0.1:8432
# IMESSAGE_BRIDGE_TOKEN=
# GITHUB_TOKEN=
# GITLAB_TOKEN=
# LINEAR_API_KEY=
# SLACK_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# TELEGRAM_BOT_TOKEN=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# NOTION_API_KEY=
# DROPBOX_TOKEN=
# HUBSPOT_TOKEN=
# SALESFORCE_ACCESS_TOKEN=
# SALESFORCE_INSTANCE_URL=
# JIRA_BASE_URL=
# JIRA_API_TOKEN=
# ASANA_TOKEN=
# TRELLO_API_KEY=
# TRELLO_TOKEN=
# AIRTABLE_TOKEN=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# STRIPE_SECRET_KEY=
# N8N_BASE_URL=
# N8N_API_KEY=
# COMPOSIO_API_KEY=
# BROWSERBASE_API_KEY=
# SENTRY_AUTH_TOKEN=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
