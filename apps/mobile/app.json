{
  "expo": {
    "name": "O1",
    "slug": "o1",
    "scheme": "o1",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.onerall.o1" },
    "android": { "package": "com.onerall.o1" },
    "web": { "bundler": "metro", "name": "O1 — agent operating system" },
    "plugins": [
      "expo-document-picker",
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf"
    ]
  }
}
